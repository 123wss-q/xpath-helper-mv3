{
  "manifest_version": 3,
  "name": "XPath Helper (MV3)",
  "version": "2.0.3",
  "description": "Unofficial Manifest V3 adaptation of XPath Helper 2.0.2. Extract, edit, and evaluate XPath queries.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "icons": {
    "16": "static/icon_16x16.png",
    "32": "static/icon_32x32.png",
    "48": "static/icon_48x48.png",
    "128": "static/icon_128x128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "bar.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_icon": {
      "19": "static/icon_19x19.png",
      "38": "static/icon_38x38.png"
    },
    "default_title": "XPath Helper (Ctrl+Shift+X)"
  }
}
